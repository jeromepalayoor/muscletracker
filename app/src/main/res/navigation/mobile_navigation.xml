<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="net.jpalayoor.muscletracker.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_session"
            app:destination="@id/navigation_session_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_workouts"
        android:name="net.jpalayoor.muscletracker.ui.workouts.WorkoutsFragment"
        android:label="@string/title_workouts"
        tools:layout="@layout/fragment_workouts">

        <action
            android:id="@+id/action_template_to_detail"
            app:destination="@id/navigation_template_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_record"
        android:name="net.jpalayoor.muscletracker.ui.record.RecordFragment"
        android:label="@string/title_record"
        tools:layout="@layout/fragment_record">

        <action
            android:id="@+id/action_record_to_session"
            app:destination="@id/navigation_session_detail" />

        <action
            android:id="@+id/action_record_to_start_workout"
            app:destination="@id/navigation_start_workout" />
    </fragment>

    <fragment
        android:id="@+id/navigation_exercises"
        android:name="net.jpalayoor.muscletracker.ui.exercises.ExercisesFragment"
        android:label="@string/title_exercises"
        tools:layout="@layout/fragment_exercises">

        <action
            android:id="@+id/action_exercises_to_detail"
            app:destination="@id/navigation_exercise_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="net.jpalayoor.muscletracker.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/navigation_exercise_detail"
        android:name="net.jpalayoor.muscletracker.ui.exercises.ExerciseDetailFragment"
        android:label="Exercise Detail"
        tools:layout="@layout/fragment_exercise_detail" />

    <fragment
        android:id="@+id/navigation_template_detail"
        android:name="net.jpalayoor.muscletracker.ui.workouts.TemplateDetailFragment"
        android:label="Template Detail"
        tools:layout="@layout/fragment_template_detail">

        <action
            android:id="@+id/action_template_detail_to_exercise_picker"
            app:destination="@id/navigation_exercise_picker" />
    </fragment>

    <fragment
        android:id="@+id/navigation_exercise_picker"
        android:name="net.jpalayoor.muscletracker.ui.workouts.ExercisePickerFragment"
        android:label="Exercise Picker"
        tools:layout="@layout/fragment_exercise_picker" />

    <fragment
        android:id="@+id/navigation_session_detail"
        android:name="net.jpalayoor.muscletracker.ui.record.SessionDetailFragment"
        android:label="Workout Session Detail"
        tools:layout="@layout/fragment_session_detail" />

    <fragment
        android:id="@+id/navigation_start_workout"
        android:name="net.jpalayoor.muscletracker.ui.record.StartWorkoutFragment"
        android:label="Choose Workout To Start"
        tools:layout="@layout/fragment_start_workout">

        <action
            android:id="@+id/action_start_workout_to_live_session"
            app:destination="@+id/navigation_live_session"/>
    </fragment>

    <fragment
        android:id="@+id/navigation_live_session"
        android:name="net.jpalayoor.muscletracker.ui.record.LiveSessionFragment"
        android:label="Live Session"
        tools:layout="@layout/fragment_live_session">

        <action
            android:id="@+id/action_live_session_to_exercise"
            app:destination="@+id/navigation_exercise_log"/>

        <action
            android:id="@+id/action_live_session_to_detail"
            app:destination="@+id/navigation_session_detail"/>
    </fragment>

    <fragment
        android:id="@+id/navigation_exercise_log"
        android:name="net.jpalayoor.muscletracker.ui.record.ExerciseLogFragment"
        android:label="Exercise Log"
        tools:layout="@layout/fragment_live_exercise_log" />
</navigation>